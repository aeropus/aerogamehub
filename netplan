<script>
// ═══════════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════════
const cv=document.getElementById('cv'),ctx=cv.getContext('2d');
const mmCv=document.getElementById('mm-cv'),mmCtx=mmCv.getContext('2d');
mmCv.width=140;mmCv.height=90;

let W=0,H=0;
let pan={x:0,y:0},zoom=1;
let stations=[],edges=[],idSeq=1;
let LINES=[
  {color:'#e8203a',name:'Rot',style:'solid'},
  {color:'#1e90ff',name:'Blau',style:'solid'},
  {color:'#e8007a',name:'Pink',style:'solid'},
  {color:'#f07800',name:'Orange',style:'solid'},
  {color:'#8878d8',name:'Lila',style:'solid'},
  {color:'#00b87c',name:'Grün',style:'solid'},
];
let activeLine=0;
let mode='add',connectFrom=null,dragging=null,editTarget=null,editLineIdx=-1;
let selectedStations=new Set();
let selRect=null; // {x0,y0,x1,y1} in canvas coords
let ctxTarget=null;
let isDark=true;
let undoStack=[],redoStack=[];
let isPanning=false,panStart={x:0,y:0},panOrigin={x:0,y:0};
let multiDragStart=null,multiDragOrigins=null;

const LW=10,GAP=1.5;

// ═══════════════════════════════════════════════════
//  RESIZE
// ═══════════════════════════════════════════════════
function resizeCanvas(){
  const wrap=document.getElementById('cv-wrap');
  W=wrap.clientWidth;H=wrap.clientHeight;
  cv.width=W;cv.height=H;
  draw();
}
window.addEventListener('resize',resizeCanvas);

// ═══════════════════════════════════════════════════
//  UNDO / REDO
// ═══════════════════════════════════════════════════
function snapshot(){
  const s=JSON.stringify({stations,edges,idSeq,LINES});
  if(undoStack.length&&undoStack[undoStack.length-1]===s)return;
  undoStack.push(s);
  if(undoStack.length>80)undoStack.shift();
  redoStack=[];
  updateUndoUI();
}
function undo(){
  if(undoStack.length<2)return;
  redoStack.push(undoStack.pop());
  const s=JSON.parse(undoStack[undoStack.length-1]);
  apply(s);updateUndoUI();draw();
}
function redo(){
  if(!redoStack.length)return;
  const state=redoStack.pop();
  undoStack.push(state);
  apply(JSON.parse(state));updateUndoUI();draw();
}
function apply(s){stations=s.stations;edges=s.edges;idSeq=s.idSeq;LINES=s.LINES;selectedStations=new Set();connectFrom=null;buildLineBar();}
function updateUndoUI(){
  document.getElementById('undo-btn').disabled=undoStack.length<2;
  document.getElementById('redo-btn').disabled=!redoStack.length;
}

// ═══════════════════════════════════════════════════
//  LINE BAR
// ═══════════════════════════════════════════════════
function buildLineBar(){
  const wrap=document.getElementById('line-chips');
  wrap.innerHTML='';
  LINES.forEach((l,i)=>{
    const chip=document.createElement('div');
    chip.className='line-chip'+(i===activeLine?' sel':'');
    chip.style.background=l.color;
    chip.innerHTML=`<div class="lc-dot"></div><span class="lc-name">${l.name}</span>`;
    chip.onclick=e=>{activeLine=i;buildLineBar()};
    chip.ondblclick=e=>{e.stopPropagation();openEditLine(i)};
    chip.title=`${l.name} (Doppelklick zum Bearbeiten)`;
    wrap.appendChild(chip);
  });
}

// ═══════════════════════════════════════════════════
//  COORD TRANSFORM
// ═══════════════════════════════════════════════════
function toWorld(sx,sy){return{x:(sx-pan.x)/zoom,y:(sy-pan.y)/zoom}}
function toScreen(wx,wy){return{x:wx*zoom+pan.x,y:wy*zoom+pan.y}}
function evWorld(e){
  const r=cv.getBoundingClientRect();
  const sx=(e.clientX-r.left)*(W/r.width);
  const sy=(e.clientY-r.top)*(H/r.height);
  return{sx,sy,wx:(sx-pan.x)/zoom,wy:(sy-pan.y)/zoom};
}
function snap(v,g){g=g||snapGrid;return Math.round(v/g)*g}

// ═══════════════════════════════════════════════════
//  SPATIAL QUERIES
// ═══════════════════════════════════════════════════
function nearestStation(wx,wy,maxWorldD=18){
  let b=null,bd=1e9;
  stations.forEach(s=>{const d=Math.hypot(s.x-wx,s.y-wy);if(d<bd){bd=d;b=s;}});
  return bd<maxWorldD/zoom?b:null; // zoom-aware threshold
}
function nearestStationS(sx,sy){
  // screen-space threshold of 18px
  let b=null,bd=1e9;
  stations.forEach(s=>{
    const sc=toScreen(s.x,s.y);
    const d=Math.hypot(sc.x-sx,sc.y-sy);
    if(d<bd){bd=d;b=s;}
  });
  return bd<18?b:null;
}
function nearestEdgeS(sx,sy){
  let b=null,bd=1e9;
  edges.forEach(e=>{
    const a=stations.find(s=>s.id===e.a),bb=stations.find(s=>s.id===e.b);
    if(!a||!bb)return;
    const as=toScreen(a.x,a.y),bs=toScreen(bb.x,bb.y);
    const dx=bs.x-as.x,dy=bs.y-as.y,len=Math.hypot(dx,dy);if(len<1)return;
    const t=Math.max(0,Math.min(1,((sx-as.x)*dx+(sy-as.y)*dy)/(len*len)));
    const d=Math.hypot(as.x+t*dx-sx,as.y+t*dy-sy);
    if(d<bd){bd=d;b=e;}
  });
  return bd<10?b:null;
}

// ═══════════════════════════════════════════════════
//  GEOMETRY
// ═══════════════════════════════════════════════════
function getEdgePts(a,b){
  const dx=b.x-a.x,dy=b.y-a.y,adx=Math.abs(dx),ady=Math.abs(dy);
  if(adx<6||ady<6||Math.abs(adx-ady)<6)return[[a.x,a.y],[b.x,b.y]];
  const diag=Math.min(adx,ady);
  let mx,my;
  if(adx>ady){mx=a.x+(dx>0?diag:-diag);my=b.y;}
  else{mx=b.x;my=a.y+(dy>0?diag:-diag);}
  return[[a.x,a.y],[mx,my],[b.x,b.y]];
}
function offsetPoly(pts,off){
  if(Math.abs(off)<0.01)return pts;
  if(pts.length===2){
    const dx=pts[1][0]-pts[0][0],dy=pts[1][1]-pts[0][1],len=Math.hypot(dx,dy)||1;
    const nx=-dy/len,ny=dx/len;
    return[[pts[0][0]+nx*off,pts[0][1]+ny*off],[pts[1][0]+nx*off,pts[1][1]+ny*off]];
  }
  return pts.map((_,i)=>{
    let nx=0,ny=0,cnt=0;
    if(i>0){const dx=pts[i][0]-pts[i-1][0],dy=pts[i][1]-pts[i-1][1],len=Math.hypot(dx,dy)||1;nx+=-dy/len;ny+=dx/len;cnt++;}
    if(i<pts.length-1){const dx=pts[i+1][0]-pts[i][0],dy=pts[i+1][1]-pts[i][1],len=Math.hypot(dx,dy)||1;nx+=-dy/len;ny+=dx/len;cnt++;}
    if(cnt){nx/=cnt;ny/=cnt;const l=Math.hypot(nx,ny)||1;nx/=l;ny/=l;}
    return[pts[i][0]+nx*off,pts[i][1]+ny*off];
  });
}
function edgeGroups(){
  const g={};
  edges.forEach((e,i)=>{
    const k=e.a<e.b?`${e.a}|${e.b}`:`${e.b}|${e.a}`;
    if(!g[k])g[k]=[];
    g[k].push(i);
  });
  return g;
}
function stationLineIds(s){
  const ls=new Set(s.lines||[]);
  edges.filter(e=>e.a===s.id||e.b===s.id).forEach(e=>ls.add(e.line));
  return[...ls];
}
function getStationOffsets(s){
  const groups=edgeGroups();
  const result=[];const seen=new Set();
  Object.values(groups).forEach(idxArr=>{
    const n=idxArr.length;
    idxArr.forEach((ei,rank)=>{
      const e=edges[ei];
      if(e.a!==s.id&&e.b!==s.id)return;
      if(seen.has(ei))return;seen.add(ei);
      const other=stations.find(x=>x.id===(e.a===s.id?e.b:e.a));
      if(!other)return;
      const basePts=getEdgePts(s,other);
      const off=(rank-(n-1)/2)*(LW+GAP);
      const dx=basePts[1][0]-basePts[0][0],dy=basePts[1][1]-basePts[0][1],len=Math.hypot(dx,dy)||1;
      const nx=-dy/len,ny=dx/len;
      result.push({line:e.line,dx:nx*off,dy:ny*off});
    });
  });
  if(result.length===0&&s.lines){s.lines.forEach(l=>result.push({line:l,dx:0,dy:0}));}
  return result;
}

// ═══════════════════════════════════════════════════
//  DRAW
// ═══════════════════════════════════════════════════
function draw(){
  ctx.clearRect(0,0,W,H);
  // Background
  const bg=isDark?'#0a1628':'#f8fafd';
  ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  // Grid
  if(showGrid){
  ctx.save();
  const gs=20*zoom,ox=pan.x%gs,oy=pan.y%gs;
  ctx.strokeStyle=isDark?'rgba(30,144,255,0.05)':'rgba(0,80,200,0.07)';
  ctx.lineWidth=1;
  for(let x=ox;x<W;x+=gs){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
  for(let y=oy;y<H;y+=gs){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  ctx.restore();
  } // end showGrid

  ctx.save();
  ctx.translate(pan.x,pan.y);ctx.scale(zoom,zoom);

  const groups=edgeGroups();

  // Draw edges
  Object.values(groups).forEach(idxArr=>{
    const n=idxArr.length;
    const e0=edges[idxArr[0]];
    const a0=stations.find(s=>s.id===e0.a),b0=stations.find(s=>s.id===e0.b);
    if(a0&&b0){
      const bw=n*LW+(n-1)*GAP;
      const basePts=getEdgePts(a0,b0);
      drawRounded(basePts,'rgba(0,0,0,0.4)',bw+6);
    }
    idxArr.forEach((ei,rank)=>{
      const e=edges[ei];
      const a=stations.find(s=>s.id===e.a),b=stations.find(s=>s.id===e.b);
      if(!a||!b)return;
      const basePts=getEdgePts(a,b);
      const off=(rank-(n-1)/2)*(LW+GAP);
      const pts=offsetPoly(basePts,off);
      const line=LINES[e.line];
      const col=line?.color||'#888';
      const style=line?.style||'solid';
      ctx.shadowColor=col;ctx.shadowBlur=6;
      drawRounded(pts,col,LW,1,style);
      ctx.shadowBlur=0;
    });
  });

  // Draw stations
  stations.forEach(s=>drawStation(s));

  // Connect preview
  if(mode==='connect'&&connectFrom&&lastMouse){
    const sc=toScreen(connectFrom.x,connectFrom.y);
    // draw in screen space — undo transform temporarily
    ctx.restore();ctx.save();
    ctx.setLineDash([4,4]);
    ctx.strokeStyle=LINES[activeLine]?.color||'#fff';
    ctx.lineWidth=2;ctx.globalAlpha=.5;
    ctx.beginPath();
    // convert connectFrom to screen
    const cfx=connectFrom.x*zoom+pan.x,cfy=connectFrom.y*zoom+pan.y;
    ctx.moveTo(cfx,cfy);ctx.lineTo(lastMouse.sx,lastMouse.sy);ctx.stroke();
    ctx.setLineDash([]);ctx.globalAlpha=1;
    ctx.save();ctx.translate(pan.x,pan.y);ctx.scale(zoom,zoom);
  }

  // Selection box
  if(selRect){
    const x=Math.min(selRect.x0,selRect.x1),y=Math.min(selRect.y0,selRect.y1);
    const w=Math.abs(selRect.x1-selRect.x0),h=Math.abs(selRect.y1-selRect.y0);
    ctx.fillStyle='rgba(30,144,255,0.08)';ctx.strokeStyle='rgba(30,144,255,0.7)';
    ctx.lineWidth=1/zoom;ctx.setLineDash([4/zoom,3/zoom]);
    ctx.fillRect(x,y,w,h);ctx.strokeRect(x,y,w,h);
    ctx.setLineDash([]);
  }

  ctx.restore();

  drawMinimap();
  updateStatusBar();
  updateLegend();
}

function drawRounded(pts,color,lw,alpha=1,style='solid'){
  if(pts.length<2)return;
  ctx.globalAlpha=alpha;
  ctx.beginPath();ctx.moveTo(pts[0][0],pts[0][1]);
  for(let i=1;i<pts.length-1;i++){
    const r=Math.min(lw*3,Math.hypot(pts[i][0]-pts[i-1][0],pts[i][1]-pts[i-1][1])*.45,Math.hypot(pts[i+1][0]-pts[i][0],pts[i+1][1]-pts[i][1])*.45);
    ctx.arcTo(pts[i][0],pts[i][1],pts[i+1][0],pts[i+1][1],r);
  }
  ctx.lineTo(pts[pts.length-1][0],pts[pts.length-1][1]);
  ctx.strokeStyle=color;ctx.lineWidth=lw;ctx.lineCap='round';ctx.lineJoin='round';
  if(style==='dashed')ctx.setLineDash([lw*2,lw*1.2]);
  else if(style==='double'){ctx.lineWidth=lw*1.6;ctx.stroke();ctx.lineWidth=lw*.5;ctx.strokeStyle=color+'80';}
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.globalAlpha=1;
}

function drawStation(s){
  const lineIds=stationLineIds(s);
  const offsets=getStationOffsets(s);
  const isSelected=selectedStations.has(s.id);
  const isConnFrom=s===connectFrom;
  const type=s.type||'normal';

  if(isSelected||isConnFrom){
    const col=isConnFrom?(LINES[activeLine]?.color||'#1e90ff'):'#1e90ff';
    ctx.shadowColor=col;ctx.shadowBlur=20/zoom;
    ctx.beginPath();ctx.arc(s.x,s.y,22/zoom,0,Math.PI*2);
    ctx.fillStyle=col+'22';ctx.fill();ctx.shadowBlur=0;
  }

  if(lineIds.length<=1){
    const col=LINES[lineIds[0]]?.color||'#999';
    const off=offsets[0]||{dx:0,dy:0};
    const cx=s.x+off.dx,cy=s.y+off.dy;
    drawStationDot(cx,cy,col,type,s);
  } else {
    const xs=offsets.map(o=>s.x+o.dx),ys=offsets.map(o=>s.y+o.dy);
    const minX=Math.min(...xs),maxX=Math.max(...xs);
    const minY=Math.min(...ys),maxY=Math.max(...ys);
    const cx=(minX+maxX)/2,cy=(minY+maxY)/2;
    const spanX=maxX-minX,spanY=maxY-minY;
    const isV=spanY>spanX;
    const rMaj=Math.max(spanX,spanY)/2+LW/2+2,rMin=LW/2+2;
    ctx.beginPath();ctx.ellipse(cx,cy,rMaj+3,rMin+3,isV?Math.PI/2:0,0,Math.PI*2);
    ctx.fillStyle='rgba(0,0,0,0.35)';ctx.fill();
    ctx.beginPath();ctx.ellipse(cx,cy,rMaj,rMin,isV?Math.PI/2:0,0,Math.PI*2);
    ctx.fillStyle='#fff';ctx.fill();
    offsets.forEach(o=>{
      const px=s.x+o.dx,py=s.y+o.dy;
      const col=LINES[o.line]?.color||'#999';
      drawStationDot(px,py,col,type,null);
    });
  }

  // Label
  drawLabel(s);
}

function drawStationDot(cx,cy,col,type,s){
  const r=LW/2;
  if(type==='terminus'){
    ctx.beginPath();
    ctx.rect(cx-r-1,cy-r-1,(r+1)*2,(r+1)*2);
    ctx.fillStyle='#fff';ctx.fill();
    ctx.strokeStyle=col;ctx.lineWidth=2;ctx.stroke();
  } else if(type==='interchange'){
    ctx.beginPath();ctx.arc(cx,cy,r+3,0,Math.PI*2);
    ctx.fillStyle=col+'30';ctx.fill();
    ctx.beginPath();ctx.arc(cx,cy,r+1.5,0,Math.PI*2);
    ctx.fillStyle='#fff';ctx.fill();
    ctx.strokeStyle=col;ctx.lineWidth=2.5;ctx.stroke();
  } else if(type==='depot'){
    const d=r+1;
    ctx.beginPath();ctx.moveTo(cx,cy-d);ctx.lineTo(cx+d,cy);ctx.lineTo(cx,cy+d);ctx.lineTo(cx-d,cy);ctx.closePath();
    ctx.fillStyle='#fff';ctx.fill();ctx.strokeStyle=col;ctx.lineWidth=2;ctx.stroke();
  } else {
    ctx.beginPath();ctx.arc(cx,cy,r+2,0,Math.PI*2);
    ctx.fillStyle=col+'28';ctx.fill();
    ctx.beginPath();ctx.arc(cx,cy,r+1.5,0,Math.PI*2);
    ctx.fillStyle='#fff';ctx.fill();ctx.strokeStyle=col;ctx.lineWidth=2;ctx.stroke();
    ctx.beginPath();ctx.arc(cx,cy,r-2,0,Math.PI*2);
    ctx.fillStyle=col+'55';ctx.fill();
  }
}

function drawLabel(s){
  const lpos=s.labelPos||'above';
  const lx=s.x,ly=s.y;
  let tx=lx,ty=ly,ta='center',tb='middle';
  const pad=LW/2+10;
  if(lpos==='above'){ty=ly-pad;ta='center';tb='alphabetic';}
  else if(lpos==='below'){ty=ly+pad+4;ta='center';tb='top';}
  else if(lpos==='left'){tx=lx-pad;ta='right';tb='middle';}
  else if(lpos==='right'){tx=lx+pad;ta='left';tb='middle';}
  ctx.font=`500 ${11/zoom>8?11:11}px "Inter",sans-serif`;
  ctx.textAlign=ta;ctx.textBaseline=tb;
  ctx.shadowColor='rgba(0,0,0,0.85)';ctx.shadowBlur=5;
  ctx.fillStyle=isDark?'rgba(232,238,248,0.97)':'rgba(20,36,64,0.97)';
  ctx.fillText(s.name,tx,ty);
  ctx.shadowBlur=0;ctx.textBaseline='alphabetic';
}

// ═══════════════════════════════════════════════════
//  MINIMAP
// ═══════════════════════════════════════════════════
function drawMinimap(){
  mmCtx.clearRect(0,0,140,90);
  mmCtx.fillStyle=isDark?'#0a1628':'#f0f4f8';
  mmCtx.fillRect(0,0,140,90);
  if(!stations.length)return;
  const xs=stations.map(s=>s.x),ys=stations.map(s=>s.y);
  const minX=Math.min(...xs)-20,maxX=Math.max(...xs)+20;
  const minY=Math.min(...ys)-20,maxY=Math.max(...ys)+20;
  const scX=130/(maxX-minX||1),scY=80/(maxY-minY||1);
  const sc=Math.min(scX,scY);
  const offX=5+(130-(maxX-minX)*sc)/2,offY=5+(80-(maxY-minY)*sc)/2;
  const toMM=(x,y)=>[(x-minX)*sc+offX,(y-minY)*sc+offY];
  edges.forEach(e=>{
    const a=stations.find(s=>s.id===e.a),b=stations.find(s=>s.id===e.b);
    if(!a||!b)return;
    const [ax,ay]=toMM(a.x,a.y),[bx,by]=toMM(b.x,b.y);
    mmCtx.beginPath();mmCtx.moveTo(ax,ay);mmCtx.lineTo(bx,by);
    mmCtx.strokeStyle=LINES[e.line]?.color||'#888';mmCtx.lineWidth=1.5;mmCtx.stroke();
  });
  stations.forEach(s=>{
    const [mx,my]=toMM(s.x,s.y);
    mmCtx.beginPath();mmCtx.arc(mx,my,2.5,0,Math.PI*2);
    mmCtx.fillStyle='#fff';mmCtx.fill();
  });
  // Viewport rect
  const vx0=(-pan.x/zoom-minX)*sc+offX,vy0=(-pan.y/zoom-minY)*sc+offY;
  const vw=(W/zoom)*sc,vh=(H/zoom)*sc;
  const vp=document.getElementById('minimap-viewport');
  const mmEl=document.getElementById('minimap');
  const mmRect=mmEl.getBoundingClientRect();
  const dispScX=mmRect.width/140,dispScY=mmRect.height/90;
  vp.style.left=Math.max(0,vx0*dispScX)+'px';
  vp.style.top=Math.max(0,vy0*dispScY)+'px';
  vp.style.width=Math.min(mmRect.width,vw*dispScX)+'px';
  vp.style.height=Math.min(mmRect.height,vh*dispScY)+'px';
}

