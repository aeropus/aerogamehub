<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Netzplan Editor v7</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0d1b2e; --surface:#132240; --surface2:#1a2e50; --border:#223560;
  --accent:#1e90ff; --text:#e8eef8; --text-dim:#7a90b8; --canvas-bg:#0a1628;
  --radius:7px; --fh:'Rajdhani',sans-serif; --fb:'Inter',sans-serif;
}
/* THEME: Dark Neutral (Standard) */
.theme-dark-neutral{
  --bg:#0d1b2e; --surface:#132240; --surface2:#1a2e50; --border:#223560;
  --accent:#1e90ff; --text:#e8eef8; --text-dim:#7a90b8; --canvas-bg:#0a1628;
}
/* THEME: Light Creamy */
.theme-light-creamy{
  --bg:#faf8f3; --surface:#fff9ed; --surface2:#f5efd9; --border:#e8dcc0;
  --accent:#d4933e; --text:#3a2f1f; --text-dim:#8a7558; --canvas-bg:#fffef8;
}
/* THEME: Light Airy */
.theme-light-airy{
  --bg:#f0f4f8; --surface:#ffffff; --surface2:#e8edf4; --border:#c8d4e8;
  --accent:#1e6fd4; --text:#1a2540; --text-dim:#6880a8; --canvas-bg:#f8fafd;
}
/* THEME: Dark Constructive */
.theme-dark-constructive{
  --bg:#1a1f28; --surface:#242932; --surface2:#2d333d; --border:#3a4350;
  --accent:#ff6b35; --text:#e5e7eb; --text-dim:#9ca3af; --canvas-bg:#141821;
}
/* THEME: Dark Sporty */
.theme-dark-sporty{
  --bg:#0f1419; --surface:#1a1f26; --surface2:#252b34; --border:#353d48;
  --accent:#00ff88; --text:#e0e6ed; --text-dim:#8b95a1; --canvas-bg:#0a0e12;
}
html,body{height:100%;background:var(--bg);overflow:hidden;transition:background .2s}
body{display:flex;flex-direction:column;font-family:var(--fb);height:100vh}
#app{width:100%;flex:1;display:flex;flex-direction:column;overflow:hidden;position:relative}

/* HEADER */
#header{display:flex;align-items:center;gap:10px;padding:8px 14px;background:var(--bg);border-bottom:1px solid var(--border);flex-shrink:0;transition:background .2s,border-color .2s}
.logo{width:32px;height:32px;border-radius:6px;background:linear-gradient(135deg,#1e90ff,#0052cc);display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;transition:transform .15s;overflow:hidden}
.logo:hover{transform:scale(1.05)}
.logo svg,.logo img{width:100%;height:100%;object-fit:contain}
.logo svg{fill:white}
#header h1{font-family:var(--fh);font-size:17px;font-weight:700;letter-spacing:.08em;color:var(--text);text-transform:uppercase}
#header h1 span{color:var(--accent)}
#map-title-inp{background:transparent;border:none;outline:none;font-family:var(--fh);font-size:14px;color:var(--text-dim);margin-left:4px;width:160px;letter-spacing:.04em;transition:color .15s}
#map-title-inp:focus{color:var(--text);border-bottom:1px solid var(--accent)}
#map-title-inp::placeholder{color:var(--text-dim);opacity:.5}
.hdr-right{display:flex;align-items:center;gap:6px;margin-left:auto}
.icon-btn{display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);background:transparent;cursor:pointer;color:var(--text-dim);transition:all .15s}
.icon-btn:hover{background:rgba(30,144,255,.1);color:var(--text);border-color:rgba(30,144,255,.4)}
.icon-btn.active{background:rgba(30,144,255,.18);color:#fff;border-color:var(--accent)}
#undo-btn:disabled,#redo-btn:disabled{opacity:.3;pointer-events:none}

/* TOOLBAR */
#toolbar{display:flex;align-items:center;gap:5px;padding:6px 14px;background:var(--surface2);border-bottom:1px solid var(--border);flex-shrink:0;flex-wrap:wrap;transition:background .2s,border-color .2s}
.tbtn{display:flex;align-items:center;gap:5px;padding:5px 11px;font-size:11.5px;font-weight:500;font-family:var(--fb);border-radius:var(--radius);cursor:pointer;border:1px solid var(--border);background:transparent;color:var(--text-dim);transition:all .15s;white-space:nowrap;letter-spacing:.02em}
.tbtn:hover{background:rgba(30,144,255,.1);border-color:rgba(30,144,255,.4);color:var(--text)}
.tbtn.active{background:rgba(30,144,255,.18);border-color:var(--accent);color:#fff}
.tbtn.red:hover,.tbtn.red.active{background:rgba(220,50,47,.15);border-color:#dc322f;color:#ff6b6b}
.tbtn kbd{font-size:9px;background:var(--border);color:var(--text-dim);border-radius:3px;padding:1px 4px;margin-left:2px}
.sep{width:1px;height:20px;background:var(--border);margin:0 2px;flex-shrink:0}
.fsep{flex:1}

/* LINE MANAGER — vertical left sidebar */
#line-bar{display:flex;flex-direction:column;align-items:stretch;gap:3px;padding:8px 6px;background:var(--surface);border-right:1px solid var(--border);flex-shrink:0;overflow-y:auto;width:112px;transition:background .2s,border-color .2s}
#line-bar::-webkit-scrollbar{width:3px}
#line-bar::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
#line-bar-label{font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim);padding:0 4px 4px;font-family:var(--fb);border-bottom:1px solid var(--border);margin-bottom:2px;flex-shrink:0}
.line-chip{display:flex;align-items:center;gap:6px;padding:5px 8px;border-radius:6px;cursor:pointer;border:2px solid transparent;transition:all .15s;font-size:11.5px;font-weight:600;color:#fff;letter-spacing:.03em;white-space:nowrap}
.line-chip:hover{filter:brightness(1.2);transform:translateX(2px)}
.line-chip.sel{border-color:rgba(255,255,255,.7);box-shadow:2px 0 12px rgba(0,0,0,.4),inset 0 0 0 1px rgba(255,255,255,.15)}
.line-chip .lc-dot{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.5);flex-shrink:0}
.line-chip .lc-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.add-line-btn{display:flex;align-items:center;justify-content:center;gap:4px;padding:5px 6px;border-radius:6px;cursor:pointer;border:1px dashed var(--border);background:transparent;color:var(--text-dim);font-size:10.5px;font-family:var(--fb);transition:all .15s;margin-top:2px}
.add-line-btn:hover{border-color:var(--accent);color:var(--accent);background:rgba(30,144,255,.06)}

/* CANVAS AREA */
#cv-area{display:flex;flex:1;overflow:hidden}
#cv-wrap{position:relative;background:var(--canvas-bg);flex:1;overflow:hidden;transition:background .2s}
#cv{display:block;width:100%;height:100%;touch-action:none}

/* MINIMAP */
#minimap{position:absolute;bottom:30px;right:10px;width:140px;height:90px;border-radius:8px;border:1px solid var(--border);overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.5);cursor:pointer;z-index:10}
#minimap canvas{display:block;width:140px;height:90px}
#minimap-viewport{position:absolute;border:1.5px solid var(--accent);background:rgba(30,144,255,.08);border-radius:2px;pointer-events:none}

/* STATUSBAR */
#sbar{padding:4px 14px;font-size:11px;color:var(--text-dim);background:var(--bg);border-top:1px solid var(--border);min-height:22px;display:flex;align-items:center;gap:8px;flex-shrink:0;transition:background .2s,border-color .2s}
.sbar-dot{width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0;animation:pulse 2s infinite}
.sbar-right{margin-left:auto;display:flex;gap:12px;font-size:10px;opacity:.7}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}

/* MODALS */
.modal-overlay{display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.5);backdrop-filter:blur(2px);align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal-box{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px;min-width:240px;max-width:360px;width:90%;box-shadow:0 24px 64px rgba(0,0,0,.7)}
.modal-box h2{font-family:var(--fh);font-size:16px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:14px;color:var(--text)}
.field{margin-bottom:12px}
.field label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-dim);margin-bottom:4px}
.field input[type=text],.field input[type=color]{width:100%;padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius);font-size:12px;font-family:var(--fb);background:var(--bg);color:var(--text);outline:none;transition:border-color .15s}
.field input[type=text]:focus{border-color:var(--accent)}
.field input[type=color]{height:34px;padding:2px 4px;cursor:pointer}
.field .row{display:flex;gap:8px}
.field .row input[type=text]{flex:1}
.seg{display:flex;gap:4px;flex-wrap:wrap}
.seg-btn{padding:4px 10px;border-radius:var(--radius);border:1px solid var(--border);background:transparent;color:var(--text-dim);font-size:11px;cursor:pointer;transition:all .15s}
.seg-btn.sel{background:rgba(30,144,255,.18);border-color:var(--accent);color:#fff}
.mbtns{display:flex;gap:8px;margin-top:4px}
.mbtns button{flex:1;padding:8px;font-size:12px;font-family:var(--fb);font-weight:500;border-radius:var(--radius);cursor:pointer;transition:all .15s}
.mbtns .ok{border:none;background:var(--accent);color:#fff}
.mbtns .ok:hover{filter:brightness(1.1)}
.mbtns .cancel{border:1px solid var(--border);background:transparent;color:var(--text-dim)}
.mbtns .cancel:hover{border-color:var(--text-dim);color:var(--text)}
.mbtns .danger{border:none;background:#c0392b;color:#fff}
.mbtns .danger:hover{background:#e74c3c}
.line-tags{display:flex;gap:5px;flex-wrap:wrap;min-height:24px}
.line-tag{padding:3px 9px;border-radius:12px;font-size:11px;color:#fff;font-weight:600;cursor:pointer;transition:opacity .15s}
.line-tag:hover{opacity:.7}

/* CONTEXT MENU */
#ctx-menu{display:none;position:fixed;z-index:300;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:4px;min-width:160px;box-shadow:0 8px 32px rgba(0,0,0,.6)}
#ctx-menu.open{display:block}
.ctx-item{display:flex;align-items:center;gap:8px;padding:7px 12px;border-radius:6px;cursor:pointer;font-size:12px;color:var(--text-dim);transition:background .1s,color .1s}
.ctx-item:hover{background:rgba(30,144,255,.1);color:var(--text)}
.ctx-item.danger:hover{background:rgba(220,50,47,.15);color:#ff6b6b}
.ctx-sep{height:1px;background:var(--border);margin:3px 6px}

/* SELECTION */
#sel-rect{position:absolute;border:1.5px dashed var(--accent);background:rgba(30,144,255,.07);pointer-events:none;border-radius:2px}

/* TOOLTIP */
#tooltip{position:fixed;z-index:400;background:rgba(10,22,40,.95);color:var(--text);font-size:11px;padding:4px 9px;border-radius:6px;pointer-events:none;border:1px solid var(--border);display:none;max-width:200px}

/* SETTINGS MODAL */
#settings-modal .modal-box{max-width:480px}
.settings-group{margin-bottom:20px}
.settings-group h3{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);margin-bottom:10px;font-weight:600}
.setting-row{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-radius:var(--radius);border:1px solid var(--border);margin-bottom:8px;transition:background .15s}
.setting-row:hover{background:rgba(30,144,255,.05)}
.setting-label{font-size:12px;color:var(--text);font-weight:500}
.setting-sublabel{font-size:10px;color:var(--text-dim);margin-top:2px}
.theme-selector{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.theme-option{padding:12px;border-radius:var(--radius);border:2px solid var(--border);cursor:pointer;text-align:center;transition:all .15s;background:var(--bg)}
.theme-option:hover{border-color:var(--accent);transform:translateY(-2px)}
.theme-option.selected{border-color:var(--accent);background:rgba(30,144,255,.1);box-shadow:0 0 0 3px rgba(30,144,255,.1)}
.theme-option-name{font-size:11px;font-weight:600;color:var(--text);margin-bottom:4px}
.theme-preview{height:30px;border-radius:4px;margin-bottom:6px;border:1px solid var(--border)}
.radio-group{display:flex;gap:8px}
.radio-btn{padding:6px 12px;border-radius:var(--radius);border:1px solid var(--border);background:transparent;color:var(--text-dim);font-size:11px;cursor:pointer;transition:all .15s;flex:1;text-align:center}
.radio-btn:hover{border-color:var(--accent);color:var(--text)}
.radio-btn.selected{background:rgba(30,144,255,.18);border-color:var(--accent);color:#fff}
.logo-upload-area{border:2px dashed var(--border);border-radius:var(--radius);padding:20px;text-align:center;cursor:pointer;transition:all .15s;margin-top:8px}
.logo-upload-area:hover{border-color:var(--accent);background:rgba(30,144,255,.05)}
.logo-upload-area.has-logo{background:rgba(30,144,255,.08);border-style:solid}
.logo-preview{width:64px;height:64px;margin:0 auto 8px;border-radius:6px;background:var(--surface2);display:flex;align-items:center;justify-content:center;overflow:hidden}
.logo-preview img,.logo-preview svg{max-width:100%;max-height:100%;object-fit:contain}
.logo-upload-text{font-size:11px;color:var(--text-dim)}
.logo-actions{display:flex;gap:6px;margin-top:8px;justify-content:center}
.logo-actions button{padding:4px 10px;font-size:10px;border-radius:4px;border:1px solid var(--border);background:transparent;color:var(--text-dim);cursor:pointer;transition:all .15s}
.logo-actions button:hover{border-color:var(--accent);color:var(--text)}

/* LEGEND PANEL */
#legend{position:absolute;bottom:30px;left:10px;background:rgba(13,27,46,.88);border:1px solid var(--border);border-radius:10px;padding:10px 14px;z-index:10;min-width:100px;display:none}
.light #legend{background:rgba(240,244,248,.92)}
#legend-title{font-family:var(--fh);font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text);margin-bottom:8px}
.leg-item{display:flex;align-items:center;gap:7px;margin-bottom:5px;font-size:11px;color:var(--text-dim)}
.leg-swatch{width:28px;height:6px;border-radius:3px;flex-shrink:0}
/* COLOR PALETTE */
.color-palette{display:grid;grid-template-columns:repeat(10,1fr);gap:4px;margin-bottom:2px}
.cp-swatch{width:100%;aspect-ratio:1;border-radius:4px;cursor:pointer;border:2px solid transparent;transition:transform .1s,border-color .1s}
.cp-swatch:hover{transform:scale(1.18);border-color:rgba(255,255,255,.5)}
.cp-swatch.sel{border-color:#fff;box-shadow:0 0 0 1px rgba(0,0,0,.4)}
</style>
</head>
<body>
<div id="app">

<!-- HEADER -->
<div id="header">
  <div class="logo" id="logo-btn" title="Logo ändern"><svg width="15" height="15" viewBox="0 0 16 16"><path d="M2 8L7 3h7v10H7z"/><circle cx="5.5" cy="10.5" r="1.8" fill="none" stroke="white" stroke-width="1.2"/><circle cx="11" cy="10.5" r="1.8" fill="none" stroke="white" stroke-width="1.2"/></svg></div>
  <h1>Netz<span>plan</span> <span style="font-size:11px;opacity:.5;font-family:var(--fb);font-weight:400;letter-spacing:0">v8</span></h1>
  <input id="map-title-inp" type="text" placeholder="Kartenname…" value="Mein Netzplan"/>
  <div class="hdr-right">
    <button class="icon-btn" id="undo-btn" onclick="undo()" title="Rückgängig (Strg+Z)" disabled>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h7a4 4 0 010 8H5"/><path d="M2 6l3-3-3 3 3 3-3-3z"/></svg>
    </button>
    <button class="icon-btn" id="redo-btn" onclick="redo()" title="Wiederholen (Strg+Y)" disabled>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6H7a4 4 0 000 8h4"/><path d="M14 6l-3-3 3 3-3 3 3-3z"/></svg>
    </button>
    <button class="icon-btn" id="settings-btn" onclick="openSettings()" title="Einstellungen">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
    </button>
    <button class="icon-btn" id="theme-btn" onclick="toggleTheme()" title="Theme wechseln">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.1 3.1l1.4 1.4M11.5 11.5l1.4 1.4M3.1 12.9l1.4-1.4M11.5 4.5l1.4-1.4"/></svg>
    </button>
    <button class="icon-btn" id="legend-btn" onclick="toggleLegend()" title="Legende">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="12" height="12" rx="2"/><path d="M5 6h6M5 9h4"/></svg>
    </button>
  </div>
</div>

<!-- TOOLBAR -->
<div id="toolbar">
  <button class="tbtn active" id="btn-add" onclick="setMode('add')" title="A"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8" cy="8" r="3.5" fill="currentColor" opacity=".3"/><path d="M8 2v4M8 10v4M2 8h4M10 8h4"/></svg> Haltestelle <kbd>A</kbd></button>
  <button class="tbtn" id="btn-connect" onclick="setMode('connect')" title="C"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="3" y1="13" x2="13" y2="3"/><circle cx="3" cy="13" r="2" fill="currentColor" stroke="none"/><circle cx="13" cy="3" r="2" fill="currentColor" stroke="none"/></svg> Verbinden <kbd>C</kbd></button>
  <button class="tbtn" id="btn-move" onclick="setMode('move')" title="M"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v12M2 8h12M5 5L8 2l3 3M5 11l3 3 3-3M5 5L2 8l3 3M11 5l3 3-3 3"/></svg> Bewegen <kbd>M</kbd></button>
  <button class="tbtn" id="btn-select" onclick="setMode('select')" title="S"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 2l4 12 2-5 5-2z"/></svg> Auswahl <kbd>S</kbd></button>
  <button class="tbtn" id="btn-edit" onclick="setMode('edit')" title="E"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2l3 3-8 8H3v-3z"/></svg> Bearbeiten <kbd>E</kbd></button>
  <button class="tbtn red" id="btn-delete" onclick="setMode('delete')" title="Del"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h12M6 4V2h4v2M5 4v9a1 1 0 001 1h4a1 1 0 001-1V4"/></svg> Löschen <kbd>Del</kbd></button>
  <div class="sep"></div>
  <input id="name-inp" type="text" value="Station" placeholder="Name…" style="padding:4px 8px;font-size:11.5px;font-family:var(--fb);border-radius:var(--radius);border:1px solid var(--border);background:var(--bg);color:var(--text);width:100px;outline:none;transition:border-color .15s" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'"/>
  <div class="sep"></div>
  <!-- Station type -->
  <select id="stype-sel" style="padding:4px 8px;font-size:11px;font-family:var(--fb);border-radius:var(--radius);border:1px solid var(--border);background:var(--bg);color:var(--text);outline:none;cursor:pointer">
    <option value="normal">● Normal</option>
    <option value="interchange">⬡ Umstieg</option>
    <option value="terminus">■ Endstation</option>
    <option value="depot">◆ Depot</option>
