  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const data=JSON.parse(e.target.result);
      if(!data.stations||!data.edges)throw new Error('Ungültiges Format');
      stations=data.stations;edges=data.edges;idSeq=data.idSeq||Math.max(0,...data.stations.map(s=>s.id))+1;
      if(data.LINES)LINES=data.LINES;
      if(data.title)document.getElementById('map-title-inp').value=data.title;
      selectedStations.clear();connectFrom=null;
      buildLineBar();snapshot();draw();
      status(`✓ "${file.name}" geladen — ${stations.length} Stationen, ${edges.length} Verbindungen.`);
