function setMode(m){
  mode=m;connectFrom=null;selRect=null;
  document.querySelectorAll('.tbtn[id^="btn-"]').forEach(b=>b.classList.remove('active'));
  document.getElementById('btn-'+m)?.classList.add('active');
  const cursors={add:'crosshair',connect:'cell',move:'grab',select:'default',edit:'pointer',delete:'pointer'};
  cv.style.cursor=cursors[m]||'default';
  const msgs={
    add:'Klicken zum Setzen einer Haltestelle — Name & Typ in der Toolbar wählen.',
    connect:'Erste Station wählen, dann zweite zum Verbinden.',
    move:'Station ziehen zum Verschieben. Mehrere: erst mit Auswahl markieren.',
    select:'Rechteck ziehen zum Markieren mehrerer Stationen.',
    edit:'Station anklicken zum Bearbeiten.',
    delete:'Station oder Strecke anklicken zum Löschen.'
  };
  status(msgs[m]||'');
  draw();
}

// ═══════════════════════════════════════════════════
//  MOUSE EVENTS
// ═══════════════════════════════════════════════════
let lastMouse=null;
let selDragStart=null;

cv.addEventListener('mousemove',e=>{
  const{sx,sy,wx,wy}=evWorld(e);
  lastMouse={sx,sy,wx,wy};

  if(isPanning){
    pan.x=panOrigin.x+(sx-panStart.x);
    pan.y=panOrigin.y+(sy-panStart.y);
    draw();return;
  }
  if(mode==='move'&&dragging){
    if(selectedStations.has(dragging.id)&&multiDragStart){
      const dx=snap(wx)-multiDragStart.wx,dy=snap(wy)-multiDragStart.wy;
      multiDragOrigins.forEach((o,id)=>{
        const s=stations.find(x=>x.id===id);
        if(s){s.x=o.x+dx;s.y=o.y+dy;}
      });
    } else {
      dragging.x=snap(wx);dragging.y=snap(wy);
    }
    draw();return;
  }
  if(mode==='select'&&selDragStart){
    selRect={x0:selDragStart.wx,y0:selDragStart.wy,x1:wx,y1:wy};
    draw();return;
  }
  // hover tooltip
  const s=nearestStationS(sx,sy);
  const tip=document.getElementById('tooltip');
  if(s){tip.style.display='block';tip.style.left=(e.clientX+14)+'px';tip.style.top=(e.clientY-6)+'px';tip.textContent=s.name+' · '+(s.type||'normal');}
  else{tip.style.display='none';}
  if(mode==='connect')draw();
});

cv.addEventListener('mousedown',e=>{
  const{sx,sy,wx,wy}=evWorld(e);

  // Middle mouse or space+drag = pan
  if(e.button===1||(e.button===0&&spaceDown)){
    isPanning=true;panStart={x:sx,y:sy};panOrigin={x:pan.x,y:pan.y};
    cv.style.cursor='grabbing';e.preventDefault();return;
  }
  if(e.button===2){
    // right click = context menu
    const s=nearestStationS(sx,sy);
    if(s){ctxTarget=s;showCtxMenu(e.clientX,e.clientY);}
    e.preventDefault();return;
  }

  closeCtxMenu();

  if(mode==='add'){
    snapshot();
    const sn={id:idSeq++,x:snap(wx),y:snap(wy),
      name:document.getElementById('name-inp').value||'Station',
      lines:[activeLine],
      type:document.getElementById('stype-sel').value,
      labelPos:document.getElementById('lpos-sel').value};
    stations.push(sn);snapshot();
  } else if(mode==='connect'){
    const s=nearestStationS(sx,sy);
    if(s){
      if(!connectFrom){connectFrom=s;status('Zweite Station wählen…');}
      else if(s!==connectFrom){
        snapshot();
        edges.push({a:connectFrom.id,b:s.id,line:activeLine});
        s.lines=[...new Set([...(s.lines||[]),activeLine])];
        connectFrom.lines=[...new Set([...(connectFrom.lines||[]),activeLine])];
        connectFrom=null;snapshot();status('Verbunden!');
      }
    }
  } else if(mode==='move'){
    const s=nearestStationS(sx,sy);
    if(s){
      dragging=s;cv.style.cursor='grabbing';
      if(selectedStations.has(s.id)){
        // group drag
        multiDragStart={wx:snap(wx),wy:snap(wy)};
        multiDragOrigins=new Map();
        selectedStations.forEach(id=>{
          const st=stations.find(x=>x.id===id);
          if(st)multiDragOrigins.set(id,{x:st.x,y:st.y});
        });
      } else {
        selectedStations.clear();multiDragStart=null;
      }
    }
  } else if(mode==='select'){
    selDragStart={wx,wy};selRect={x0:wx,y0:wy,x1:wx,y1:wy};
    selectedStations.clear();
  } else if(mode==='edit'){
    const s=nearestStationS(sx,sy);if(s)openEditModal(s);
  } else if(mode==='delete'){
    const s=nearestStationS(sx,sy);
    if(s){snapshot();edges=edges.filter(e=>e.a!==s.id&&e.b!==s.id);stations=stations.filter(x=>x!==s);selectedStations.delete(s.id);snapshot();}
    else{const ed=nearestEdgeS(sx,sy);if(ed){snapshot();edges=edges.filter(x=>x!==ed);snapshot();}}
  }
  draw();
});

cv.addEventListener('mouseup',e=>{
  if(isPanning){isPanning=false;const cursors={add:'crosshair',connect:'cell',move:'grab',select:'default',edit:'pointer',delete:'pointer'};cv.style.cursor=cursors[mode]||'default';draw();return;}
  if(mode==='move'&&dragging){snapshot();dragging=null;multiDragStart=null;cv.style.cursor='grab';draw();return;}
  if(mode==='select'&&selRect){
    // finalize selection
    const x0=Math.min(selRect.x0,selRect.x1),x1=Math.max(selRect.x0,selRect.x1);
    const y0=Math.min(selRect.y0,selRect.y1),y1=Math.max(selRect.y0,selRect.y1);
    stations.forEach(s=>{if(s.x>=x0&&s.x<=x1&&s.y>=y0&&s.y<=y1)selectedStations.add(s.id);});
    selRect=null;selDragStart=null;
    status(`${selectedStations.size} Stationen ausgewählt.`);
    draw();
  }
});

cv.addEventListener('wheel',e=>{
  e.preventDefault();
  // Normalize delta (deltaMode 1=lines, 0=pixels)
  const lineSize=20;
  const dx=e.deltaMode===1?e.deltaX*lineSize:e.deltaX;
  const dy=e.deltaMode===1?e.deltaY*lineSize:e.deltaY;
  if(e.ctrlKey||e.metaKey){
    // Ctrl+Scroll = Zoom toward cursor
    const{sx,sy}=evWorld(e);
    const factor=dy<0?1.1:1/1.1;
    const newZoom=Math.max(0.15,Math.min(5,zoom*factor));
    pan.x=sx-(sx-pan.x)*newZoom/zoom;
    pan.y=sy-(sy-pan.y)*newZoom/zoom;
    zoom=newZoom;
  } else {
    // Scroll = Pan (Shift+Scroll swaps axes)
    if(e.shiftKey){
      pan.x-=dy;
      pan.y-=dx;
    } else {
      pan.x-=dx;
      pan.y-=dy;
    }
  }
  draw();
},{passive:false});

cv.addEventListener('contextmenu',e=>e.preventDefault());

// Touch
let lastTouchDist=0;
cv.addEventListener('touchstart',e=>{
  if(e.touches.length===2){lastTouchDist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);return;}
  const t=e.touches[0];cv.dispatchEvent(new MouseEvent('mousedown',{clientX:t.clientX,clientY:t.clientY,button:0}));
},{passive:false});
cv.addEventListener('touchmove',e=>{
  if(e.touches.length===2){
    const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
    const factor=d/lastTouchDist;lastTouchDist=d;
    zoom=Math.max(0.15,Math.min(5,zoom*factor));draw();return;
  }
  e.preventDefault();const t=e.touches[0];
  cv.dispatchEvent(new MouseEvent('mousemove',{clientX:t.clientX,clientY:t.clientY}));
},{passive:false});
cv.addEventListener('touchend',e=>{cv.dispatchEvent(new MouseEvent('mouseup',{}));},{passive:false});

// Space pan
let spaceDown=false;
document.addEventListener('keydown',e=>{
  if(e.target.tagName==='INPUT')return;
  if(e.code==='Space'){spaceDown=true;cv.style.cursor='grab';e.preventDefault();}
  if(e.ctrlKey||e.metaKey){
    if(e.key==='z'){undo();e.preventDefault();}
    if(e.key==='y'||e.key==='Z'){redo();e.preventDefault();}
    if(e.key==='a'){selectedStations=new Set(stations.map(s=>s.id));draw();e.preventDefault();}
  }
  const map={a:'add',c:'connect',m:'move',s:'select',e:'edit'};
  if(map[e.key]&&!e.ctrlKey)setMode(map[e.key]);
  if(e.key==='Delete'||e.key==='Backspace'){
    if(selectedStations.size){
      snapshot();
      edges=edges.filter(e=>!selectedStations.has(e.a)&&!selectedStations.has(e.b));
      stations=stations.filter(s=>!selectedStations.has(s.id));
      selectedStations.clear();snapshot();draw();
    }
  }
  if(e.key==='Escape'){selectedStations.clear();connectFrom=null;closeCtxMenu();draw();}
  if(e.key==='+')zoomStep(1.2);
  if(e.key==='-')zoomStep(1/1.2);
  if(e.key==='0'){zoom=1;pan={x:W/2-getWorldBounds().cx*zoom,y:H/2-getWorldBounds().cy*zoom};draw();}
});
document.addEventListener('keyup',e=>{if(e.code==='Space'){spaceDown=false;cv.style.cursor=mode==='move'?'grab':'crosshair';}});

function zoomStep(f){zoom=Math.max(.15,Math.min(5,zoom*f));draw();}
function getWorldBounds(){
  if(!stations.length)return{cx:0,cy:0};
  const xs=stations.map(s=>s.x),ys=stations.map(s=>s.y);
  return{cx:(Math.min(...xs)+Math.max(...xs))/2,cy:(Math.min(...ys)+Math.max(...ys))/2};
}

// Minimap click to pan
document.getElementById('minimap').addEventListener('click',e=>{
  if(!stations.length)return;
  const r=document.getElementById('minimap').getBoundingClientRect();
  const mx=(e.clientX-r.left)/r.width*140,my=(e.clientY-r.top)/r.height*90;
  const xs=stations.map(s=>s.x),ys=stations.map(s=>s.y);
  const minX=Math.min(...xs)-20,maxX=Math.max(...xs)+20;
  const minY=Math.min(...ys)-20,maxY=Math.max(...ys)+20;
  const scX=130/(maxX-minX||1),scY=80/(maxY-minY||1);
  const sc=Math.min(scX,scY);
  const offX=5+(130-(maxX-minX)*sc)/2,offY=5+(80-(maxY-minY)*sc)/2;
  const wx=(mx-offX)/sc+minX,wy=(my-offY)/sc+minY;
  pan.x=W/2-wx*zoom;pan.y=H/2-wy*zoom;draw();
});

// ═══════════════════════════════════════════════════
//  CONTEXT MENU
// ═══════════════════════════════════════════════════
function showCtxMenu(x,y){
  const m=document.getElementById('ctx-menu');
  m.style.left=x+'px';m.style.top=y+'px';m.classList.add('open');
}
function closeCtxMenu(){document.getElementById('ctx-menu').classList.remove('open');}
document.addEventListener('click',e=>{if(!e.target.closest('#ctx-menu'))closeCtxMenu();});
function ctxEdit(){if(ctxTarget)openEditModal(ctxTarget);closeCtxMenu();}
function ctxDelete(){
  if(ctxTarget){snapshot();edges=edges.filter(e=>e.a!==ctxTarget.id&&e.b!==ctxTarget.id);stations=stations.filter(s=>s!==ctxTarget);snapshot();draw();}
  closeCtxMenu();
}
function ctxDuplicate(){
  if(ctxTarget){
    snapshot();
    const ns={...ctxTarget,id:idSeq++,x:ctxTarget.x+30,y:ctxTarget.y+30,name:ctxTarget.name+' (Kopie)'};
    stations.push(ns);snapshot();draw();
  }
  closeCtxMenu();
}

// ═══════════════════════════════════════════════════
//  EDIT MODAL
// ═══════════════════════════════════════════════════
function openEditModal(s){
  editTarget=s;
  document.getElementById('ename').value=s.name;
  // type seg
  document.querySelectorAll('#etype-seg .seg-btn').forEach(b=>{b.classList.toggle('sel',b.dataset.v===(s.type||'normal'));});
