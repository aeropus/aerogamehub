function buildPalette(palId, colorInpId, colorHexId){
  const pal=document.getElementById(palId);
  if(!pal)return;
  pal.innerHTML='';
  const curVal=document.getElementById(colorInpId).value.toLowerCase();
  PALETTE.forEach(c=>{
    const sw=document.createElement('div');
    sw.className='cp-swatch'+(curVal===c.toLowerCase()?' sel':'');
    sw.style.background=c;
    sw.title=c;
    sw.addEventListener('click',()=>{
      document.getElementById(colorInpId).value=c;
      document.getElementById(colorHexId).value=c;
      pal.querySelectorAll('.cp-swatch').forEach(s=>s.classList.remove('sel'));
      sw.classList.add('sel');
    });
    pal.appendChild(sw);
