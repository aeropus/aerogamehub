function deleteLine(){
  if(editLineIdx<0)return;
  snapshot();
  edges=edges.filter(e=>e.line!==editLineIdx);
  edges=edges.map(e=>({...e,line:e.line>editLineIdx?e.line-1:e.line}));
  stations.forEach(s=>{s.lines=(s.lines||[]).filter(l=>l!==editLineIdx).map(l=>l>editLineIdx?l-1:l);});
  LINES.splice(editLineIdx,1);
  if(activeLine>=LINES.length)activeLine=LINES.length-1;
  snapshot();buildLineBar();closeModal('editline-modal');draw();
