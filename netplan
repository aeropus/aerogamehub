  '#e8203a','#c0392b','#e74c3c','#ff6b6b','#ff8c42',
  '#f07800','#f1c40f','#f9ca24','#badc58','#27ae60',
  '#00b87c','#1abc9c','#00cec9','#0984e3','#1e90ff',
  '#4a90d9','#6c5ce7','#8878d8','#a29bfe','#e84393',
