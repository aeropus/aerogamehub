// ═══════════════════════════════════════════════════
//  EXPORT SVG
// ═══════════════════════════════════════════════════
function exportSVG(){
  const title=document.getElementById('map-title-inp').value||'Netzplan';
  const groups=edgeGroups();
  let s=`<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">\n`;
  s+=`<title>${title}</title>\n`;
  s+=`<rect width="${W}" height="${H}" fill="${isDark?'#0a1628':'#f8fafd'}"/>\n`;
  Object.values(groups).forEach(idxArr=>{
    const n=idxArr.length;
    idxArr.forEach((ei,rank)=>{
      const e=edges[ei];
      const a=stations.find(x=>x.id===e.a),b=stations.find(x=>x.id===e.b);
      if(!a||!b)return;
      const basePts=getEdgePts(a,b);
      const off=(rank-(n-1)/2)*(LW+GAP);
      const pts=offsetPoly(basePts,off).map(p=>[p[0]*zoom+pan.x,p[1]*zoom+pan.y]);
      let d=`M${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
      for(let i=1;i<pts.length;i++)d+=` L${pts[i][0].toFixed(1)} ${pts[i][1].toFixed(1)}`;
      const line=LINES[e.line];
      const dash=line?.style==='dashed'?` stroke-dasharray="${LW*2} ${LW*1.2}"`:''
      s+=`<path d="${d}" fill="none" stroke="${line?.color||'#888'}" stroke-width="${LW*zoom}" stroke-linecap="round" stroke-linejoin="round"${dash}/>\n`;
    });
  });
  stations.forEach(st=>{
    const offsets=getStationOffsets(st);
    offsets.forEach(o=>{
      const px=(st.x+o.dx)*zoom+pan.x,py=(st.y+o.dy)*zoom+pan.y;
      s+=`<circle cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" r="${(LW/2+1.5)*zoom}" fill="white"/>\n`;
    });
    const tx=st.x*zoom+pan.x,ty=st.y*zoom+pan.y;
    const lpos=st.labelPos||'above';
    const pad=(LW/2+10)*zoom;
    let lx=tx,ly=ty,ta='middle';
    if(lpos==='above'){ly=ty-pad;}else if(lpos==='below'){ly=ty+pad+4;}
    else if(lpos==='left'){lx=tx-pad;ta='end';}else{lx=tx+pad;ta='start';}
    s+=`<text x="${lx.toFixed(1)}" y="${ly.toFixed(1)}" text-anchor="${ta}" font-size="${11*zoom}" font-family="Inter,sans-serif" fill="${isDark?'#e8eef8':'#1a2540'}">${st.name}</text>\n`;
  });
  // Legend
  s+=`<g transform="translate(10,${H-20-LINES.length*18})">\n`;
  LINES.forEach((l,i)=>{s+=`<rect x="0" y="${i*18}" width="24" height="6" rx="3" fill="${l.color}"/><text x="30" y="${i*18+6}" font-size="11" font-family="Inter,sans-serif" fill="${isDark?'#e8eef8':'#1a2540'}">${l.name}</text>\n`;});
  s+=`</g>\n</svg>`;
  const blob=new Blob([s],{type:'image/svg+xml'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);
  a.download=(document.getElementById('map-title-inp').value||'netzplan')+'.svg';a.click();
}

