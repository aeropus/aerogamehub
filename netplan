  };
  reader.readAsText(file);event.target.value='';
}

// ═══════════════════════════════════════════════════
//  SVG IMPORT
// ═══════════════════════════════════════════════════
function loadSVG(event){
  const file=event.target.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const parser=new DOMParser();
      const doc=parser.parseFromString(e.target.result,'image/svg+xml');
      if(doc.querySelector('parsererror'))throw new Error('SVG nicht parsebar');
      const svgEl=doc.querySelector('svg');
      const vb=svgEl?.getAttribute('viewBox');
      let svgW=parseFloat(svgEl?.getAttribute('width')||W);
      let svgH=parseFloat(svgEl?.getAttribute('height')||H);
      if(vb){const p=vb.trim().split(/[\s,]+/);svgW=parseFloat(p[2]);svgH=parseFloat(p[3]);}
      const scX=W/svgW,scY=H/svgH;
      function colorToLine(col){
        if(!col||col==='none'||['white','#fff','#ffffff'].includes(col.toLowerCase()))return -1;
        const norm=col.toLowerCase().replace(/\s/g,'');
        for(let i=0;i<LINES.length;i++)if(LINES[i].color.toLowerCase()===norm)return i;
        function hRGB(h){h=h.replace('#','');if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];return[parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)];}
        if(!norm.startsWith('#'))return 0;
        let best=0,bestD=1e9;const tRGB=hRGB(norm);
        for(let i=0;i<LINES.length;i++){const d=Math.sqrt(tRGB.reduce((s,v,j)=>(s+(v-hRGB(LINES[i].color)[j])**2),0));if(d<bestD){bestD=d;best=i;}}
        return best;
      }
      const newS=[],newE=[];let seq=1;
      const labelMap={};
      doc.querySelectorAll('text').forEach(t=>{
        const x=parseFloat(t.getAttribute('x')||0)*scX,y=parseFloat(t.getAttribute('y')||0)*scY;
        const txt=(t.textContent||'').trim();
        if(txt)labelMap[`${Math.round(x/10)*10},${Math.round(y/10)*10}`]=txt;
      });
      function nearLabel(sx,sy,max=40){let b=null,bd=1e9;for(const[k,l] of Object.entries(labelMap)){const[lx,ly]=k.split(',').map(Number);const d=Math.hypot(lx-sx,ly-sy);if(d<bd){bd=d;b=l;}}return bd<max?b:null;}
      const stMap={};
      doc.querySelectorAll('circle').forEach(el=>{
        const cx=parseFloat(el.getAttribute('cx')||0)*scX,cy=parseFloat(el.getAttribute('cy')||0)*scY;
        const r=parseFloat(el.getAttribute('r')||0)*Math.min(scX,scY);
        const fill=(el.getAttribute('fill')||'').toLowerCase();
        if(r<2.5)return;if(!['white','#fff','#ffffff'].includes(fill)&&fill!=='none')return;
        const k=`${Math.round(cx/12)*12},${Math.round(cy/12)*12}`;if(stMap[k])return;
        const st={id:seq++,x:Math.round(cx),y:Math.round(cy),name:nearLabel(cx,cy-LW-6)||nearLabel(cx,cy+LW+6)||'Station',lines:[],type:'normal',labelPos:'above'};
        stMap[k]=st;newS.push(st);
      });
      const svgClone=svgEl.cloneNode(true);
      svgClone.style.cssText='position:absolute;left:-9999px;top:-9999px;width:'+svgW+'px;height:'+svgH+'px;visibility:hidden';
      document.body.appendChild(svgClone);
      function findSt(x,y,mx=30){let b=null,bd=1e9;for(const s of newS){const d=Math.hypot(s.x-x,s.y-y);if(d<bd){bd=d;b=s;}}return bd<mx?b:null;}
      svgClone.querySelectorAll('path').forEach(el=>{
        const stroke=(el.getAttribute('stroke')||'').toLowerCase();
        const fill=(el.getAttribute('fill')||'').toLowerCase();
        const li=colorToLine(stroke)>=0?colorToLine(stroke):colorToLine(fill);if(li<0)return;
        const sw=parseFloat(el.getAttribute('stroke-width')||1)*Math.min(scX,scY);if(sw<3)return;
        try{
          const tot=el.getTotalLength();if(tot<10)return;
          const p0=el.getPointAtLength(0),p1=el.getPointAtLength(tot);
          const stA=findSt(p0.x*scX,p0.y*scY),stB=findSt(p1.x*scX,p1.y*scY);
          if(!stA||!stB||stA===stB)return;
          const dup=newE.find(e=>(e.a===stA.id&&e.b===stB.id||e.a===stB.id&&e.b===stA.id)&&e.line===li);
          if(dup)return;
          newE.push({a:stA.id,b:stB.id,line:li});
          stA.lines=[...new Set([...(stA.lines||[]),li])];
          stB.lines=[...new Set([...(stB.lines||[]),li])];
        }catch{}
      });
      document.body.removeChild(svgClone);
      if(!newS.length)throw new Error('Keine Stationen (weiße Kreise) gefunden');
      stations=newS;edges=newE;idSeq=seq;
      selectedStations.clear();connectFrom=null;buildLineBar();snapshot();draw();
      status(`✓ SVG importiert — ${stations.length} Stationen, ${edges.length} Verbindungen.`);
    }catch(err){status('⚠ SVG-Import Fehler: '+err.message);}
  };
  reader.readAsText(file);event.target.value='';
}

